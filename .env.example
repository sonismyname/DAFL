# ==========================================
# DAFL E-COMMERCE ENVIRONMENT CONFIGURATION
# ==========================================

# Microsoft SQL Server
SA_PASSWORD=YourStrong@Passw0rd123!

# Redis Cache (Set to false to test graceful degradation without Redis)
CACHE_ENABLED=true

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# PayOS Payment Gateway Credentials (Replace with your actual keys from https://payos.vn)
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# Frontend Configuration
FRONTEND_PORT=3000
BACKEND_PORT=5000
